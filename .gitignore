# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/

# Course materials: committed deliberately, so everyone works from the same
# files without re-downloading them. Anything else dropped into data/ stays out.
data/*
!data/.gitkeep
!data/fraud_dataset.csv
!data/fraud_dataset_documentation.pdf
!data/digits.csv
!data/digits_test.csv
!data/more_digits.csv
!data/digit_dataset_loader.py

# Generated artefacts (never commit these)
results/*
!results/.gitkeep

# Notebook checkpoints
.ipynb_checkpoints/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Tooling caches
.mypy_cache/
.ruff_cache/
